DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres

SERVER_PORT=8080

JWT_SECRET=change-me-in-production-please-this-is-a-dev-secret
