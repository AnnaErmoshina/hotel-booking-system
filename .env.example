ADMIN_LAST_NAME=Admin

# Cancellation policy: free cancellation up to N days before check-in,
# otherwise a % penalty of the booking's total price.
FREE_CANCELLATION_DAYS=2
LATE_CANCELLATION_PENALTY_PERCENT=50
